[Unit]
Description=Todo: сервер и Telegram-бот
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=todo
Group=todo
WorkingDirectory=/opt/todo/current
EnvironmentFile=/etc/todo.env
ExecStart=/usr/bin/env node /opt/todo/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
StateDirectory=todo
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/todo

[Install]
WantedBy=multi-user.target
