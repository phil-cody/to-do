# На VPS замените на окончательный HTTPS-домен, без слеша в конце.
APP_ORIGIN=http://localhost:4001
PORT=4001
DATABASE_PATH=./data/todo.sqlite
DIST_DIR=./dist
TELEGRAM_BOT_USERNAME=just_to_do_it_bot
# Токен BotFather задаётся только в .env или /etc/todo.env на сервере.
TELEGRAM_BOT_TOKEN=
# Каждый пользователь Telegram получает отдельную рабочую область.
TELEGRAM_OPEN_REGISTRATION=true
# Дополнительное ограничение используется при OPEN_REGISTRATION=false.
TELEGRAM_ALLOWED_IDS=
