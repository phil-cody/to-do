{
  "name": "to-do",
  "version": "1.0.0",
  "description": "React workspace for tasks and projects with Markdown and Kanban",
  "keywords": [
    "react",
    "todo",
    "kanban",
    "markdown"
  ],
  "homepage": "https://github.com/phil-cody/to-do#readme",
  "bugs": {
    "url": "https://github.com/phil-cody/to-do/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phil-cody/to-do.git"
  },
  "license": "ISC",
  "author": "Dmitrii Kachuk <antaress07@icloud.com>",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev-server.mjs",
    "prod": "npm run build",
    "watch": "npm run dev",
    "build": "webpack --mode production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src/app src/index.js src/template.html tests webpack.config.js playwright.config.js scripts server deploy/*.mjs README.md docs package.json",
    "preview": "node scripts/preview-server.mjs",
    "build:dev": "webpack --mode development",
    "format:check": "prettier --check src/app src/index.js src/template.html tests webpack.config.js playwright.config.js scripts server deploy/*.mjs README.md docs package.json",
    "test:visual": "node scripts/check-visuals.mjs",
    "server": "node --env-file-if-exists=.env server/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-sanitize": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
